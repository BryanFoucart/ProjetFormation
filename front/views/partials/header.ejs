<!DOCTYPE html>
<html lang="fr" data-theme="light">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Mon site de cryptos" />
  <meta property="og:url" content="<%= process.env.SITE_URL %>" />
  <meta property="og:type" content="website" />
  <meta property="og:titre" content="My crpto" />
  <meta property="og:image" content="<%= process.env.SITE_URL %>/assets/images/Background_with_octogone_.png" />
  <meta property="og:description" content="Mon site de cryptos" />
  <meta type="keywords" content="crypto, investissement, portefeuille, cryptos, bitcoin, monnaie virtuelle" />
  <link rel="stylesheet" href="/assets/styles/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
  <script type="module" src="<%= process.env.SITE_URL %>/assets/js/main.js"></script>
  <title> <%= typeof title !== "undefined" ? "My crypto | " + title : "My Crypto" %></title>
  <link rel="icon" type="image/png" href="<%= process.env.SITE_URL %>/assets/favicons/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="<%= process.env.SITE_URL %>/assets/favicons/favicon.svg" />
  <link rel="shortcut icon" href="<%= process.env.SITE_URL %>/assets/favicons/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="<%= process.env.SITE_URL %>/assets/favicons/apple-touch-icon.png" />
  <link rel="manifest" href="<%= process.env.SITE_URL %>/assets/favicons/site.webmanifest" />
</head>
<header>
  <nav>
    <div id="logo">
      <a href="<%= process.env.SITE_URL %>" arial-lab="Logo bitcoin"><i class="fas fa-bitcoin-sign"></i></a>
    </div>
    <div id="nav">
      <ul>
        <li>
          <i class="fas fa-house"></i>
          <a href="#">Accueil</a>
        </li>
        <li>
          <i class="fab fa-bitcoin"></i>
          <a href="#projet">Le projet</a>
        </li>
        <li>
          <i class="fab fa-ethereum"></i>
          <a href="#cryptos">Nos Cryptos</a>
        </li>
        <li>
          <i class="fas fa-horse"></i>
          <a href="#carrousel">Carrousel</a>
        </li>
        <li>
          <i class="fab fa-contao"></i>
          <a href="/contact">Contact</a>
        </li>
      </ul>
      <i data-theme-toggler class="fas fa-moon"></i>
    </div>
    <i id="toggle-nav" class="fas fa-bars"></i>
  </nav>
</header>

<body></body>

</html>